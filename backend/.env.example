# Required — no default, app will fail to start without these
LLM_API_KEY=your-gemini-api-key-here
DATABASE_URL=postgresql://user:password@localhost:5432/dasher
JWT_SECRET=replace-with-a-long-random-string

# LLM
LLM_MODEL=gemini/gemini-3.1-flash-lite
LLM_RATE_LIMIT_COOLDOWN_SECONDS=5

# Database
DB_POOL_MIN=2
DB_POOL_MAX=10
# DATABASE_URL_LOCAL=          # only needed for standalone scripts run outside Docker

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=4

# Agent
AGENT_MAX_INSPECT_CALLS=3
AGENT_MAX_ITERATIONS=12

# Upload limits
MAX_UPLOAD_MB=30
MAX_ROWS=100000
MAX_COLUMNS=50

# Environment — "development" | "production", gates /docs, /redoc, default CORS origin
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Quota
DAILY_CALL_LIMIT=50

# Observability — leave blank for local dev (falls back to file exporter)
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# Only needed if using docker-compose's bundled postgres:16 image
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=